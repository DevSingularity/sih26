PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/polarops_maitri
STATION_CODE=MAITRI
DEVICE_JWT_SECRET=change-me                 # verifies phone bearer tokens
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=maitri.station.events
CENTRAL_SERVER_BASE_URL=http://localhost:4000
CENTRAL_SERVER_API_KEY=change-me             # matches STATION_SERVICE_API_KEY on central
OUTBOX_FLUSH_INTERVAL_MINUTES=10
OUTBOX_IMMEDIATE_POLL_SECONDS=5
